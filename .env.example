# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets. This `.env.example` must
# contain placeholders only.

# --- Shopify ---
# During local development `shopify app dev` injects these automatically, so you
# usually do NOT need them here. Set them explicitly when self-hosting in
# production (e.g. on the Hostinger subdomain). Values come from the app's
# Settings > Credentials page in the Shopify dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated access scopes (must match shopify.app.toml [access_scopes]).
SCOPES=
# Public URL of the deployed app, e.g. https://ecom-oms.baisajaipur.in
SHOPIFY_APP_URL=

# --- Supabase (business-data backend) ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Anon/public key — safe for browser/client use (RLS applies). Reserved for any
# future client-side access; the server backend uses the service-role key below.
SUPABASE_ANON_KEY=
# Service-role key — SERVER-ONLY. Bypasses Row Level Security. Used by
# app/supabase.server.ts. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Prisma session storage (Postgres / Supabase) ---
# Session storage runs on Supabase Postgres in production. On serverless hosts
# (e.g. Vercel) the filesystem is ephemeral, so SQLite cannot persist sessions.
# Both values come from Supabase → Project Settings → Database → Connection string.
# DATABASE_URL = the POOLED connection (PgBouncer, port 6543, `?pgbouncer=true`);
# used by the app at runtime.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL = the DIRECT connection (port 5432, no pooler); used by Prisma for
# migrations / `prisma db push`.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
